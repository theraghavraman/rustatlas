  "slug": "refutability-whether-a-pattern-might-fail-to-match-1",
  "title": "Refutability: Whether a Pattern Might Fail to Match",
  "headings": [
    {
      "level": 1,
      "title": "Refutability: Whether a Pattern Might Fail to Match",
      "anchor": "refutability-whether-a-pattern-might-fail-to-match-1"
    },
    {
      "level": 2,
      "title": "Refutability: Whether a Pattern Might Fail to Match",
