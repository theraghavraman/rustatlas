  "html": "<h1 data-atlas-hash=\"948f66a1ae0c42a444dc5d9f70f623b1ec40a6a0cef881f9f7a6f3e98a0ba19b\" data-atlas-id=\"f-translations-of-the-book:heading:00001:948f66a1ae\" data-atlas-type=\"heading\" id=\"f---translations-of-the-book\"><a class=\"header\" href=\"#read/f-translations-of-the-book?anchor=f---translations-of-the-book\">F - Translations of the Book</a></h1>\n<h2 data-atlas-hash=\"31fe251fea526091be1806b72be2b026760f00990af899254740c2c4ac5a0593\" data-atlas-id=\"f-translations-of-the-book:heading:00002:31fe251fea\" data-atlas-type=\"heading\" id=\"appendix-f-translations-of-the-book\"><a class=\"header\" href=\"#read/f-translations-of-the-book?anchor=appendix-f-translations-of-the-book\">Appendix F: Translations of the Book</a></h2>\n<p data-atlas-hash=\"d875e0dd3e9a9837911590fc4838ca32dd6b7a3a84f204ea885eb7e3f5955ab0\" data-atlas-id=\"f-translations-of-the-book:paragraph:00001:d875e0dd3e\" data-atlas-type=\"paragraph\">For resources in languages other than English. Most are still in progress; see <a href=\"https://github.com/rust-lang/book/issues?q=is%3Aopen+is%3Aissue+label%3ATranslations\" rel=\"noopener noreferrer\" target=\"_blank\">the Translations label</a> to help or let us know about a new translation!</p>\n<ul data-atlas-hash=\"70ed784c5d903beb8074c5780c341e67f69ac45e284f67c3104aaa851411a492\" data-atlas-id=\"f-translations-of-the-book:list:00001:70ed784c5d\" data-atlas-type=\"list\">\n<li data-atlas-hash=\"a7e72607dfff805c09583a1c633bc3777f4d5e8a29db9390182878d3089f570a\" data-atlas-id=\"f-translations-of-the-book:list_item:00001:a7e72607df\" data-atlas-type=\"list_item\"><a href=\"https://github.com/rust-br/rust-book-pt-br\" rel=\"noopener noreferrer\" target=\"_blank\">Português</a> (BR)</li>\n<li data-atlas-hash=\"75350625a176c2b684d206c8b682009420a7112ff5752874e7687176a7be2a8f\" data-atlas-id=\"f-translations-of-the-book:list_item:00002:75350625a1\" data-atlas-type=\"list_item\"><a href=\"https://github.com/nunojesus/rust-book-pt-pt\" rel=\"noopener noreferrer\" target=\"_blank\">Português</a> (PT)</li>\n<li data-atlas-hash=\"5becf0fc76278dad696959ea0d29e3496a5cd46622faa70b72cece1a31d6786e\" data-atlas-id=\"f-translations-of-the-book:list_item:00003:5becf0fc76\" data-atlas-type=\"list_item\">简体中文: <a href=\"https://github.com/KaiserY/trpl-zh-cn\" rel=\"noopener noreferrer\" target=\"_blank\">KaiserY/trpl-zh-cn</a>, <a href=\"https://github.com/gnu4cn/rust-lang-Zh_CN\" rel=\"noopener noreferrer\" target=\"_blank\">gnu4cn/rust-lang-Zh_CN</a></li>\n<li data-atlas-hash=\"0f26c8986a106a7975a89ed354d5f5b241fbf706205910d0570246d3f57655e6\" data-atlas-id=\"f-translations-of-the-book:list_item:00004:0f26c8986a\" data-atlas-type=\"list_item\"><a href=\"https://github.com/rust-tw/book-tw\" rel=\"noopener noreferrer\" target=\"_blank\">正體中文</a></li>\n<li data-atlas-hash=\"5d7a83db1991ff96daa7f92cc5a20dd3a25a7c4db121f16eb72e9db14bb77547\" data-atlas-id=\"f-translations-of-the-book:list_item:00005:5d7a83db19\" data-atlas-type=\"list_item\"><a href=\"https://rust-lang-ua.github.io/rustbook_ukrainian\" rel=\"noopener noreferrer\" target=\"_blank\">Українська</a></li>\n<li data-atlas-hash=\"21cb166dfaee2ecb150e5cc0debc2aa2392fe0ce56c05af9de484a5f42d13dbd\" data-atlas-id=\"f-translations-of-the-book:list_item:00006:21cb166dfa\" data-atlas-type=\"list_item\"><a href=\"https://github.com/thecodix/book\" rel=\"noopener noreferrer\" target=\"_blank\">Español</a>, <a href=\"https://github.com/ManRR/rust-book-es\" rel=\"noopener noreferrer\" target=\"_blank\">alternate</a>, <a href=\"https://github.com/RustLangES/rust-book-es\" rel=\"noopener noreferrer\" target=\"_blank\">Español por RustLangES</a></li>\n<li data-atlas-hash=\"6da140fdd4be01893bd14afe43ad5d1cc2a4eec98fc37e67e91e0c63fd703094\" data-atlas-id=\"f-translations-of-the-book:list_item:00007:6da140fdd4\" data-atlas-type=\"list_item\"><a href=\"https://github.com/rust-lang-ru/book\" rel=\"noopener noreferrer\" target=\"_blank\">Русский</a></li>\n<li data-atlas-hash=\"e